{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "cases"],
  "properties": {
    "schema_version": {"const": 2},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "hook", "protocol", "timeout_seconds"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "description": {"type": "string", "minLength": 1},
        "hook": {"type": "string", "minLength": 1},
        "protocol": {"const": "sre-agent"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "requirement", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "input", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "finding": {"type": "string", "minLength": 1},
          "criterion": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "input": {},
          "expected": {
            "type": "object", "additionalProperties": false,
            "required": ["outcome"],
            "properties": {"outcome": {"enum": ["no_objection", "block"]}}
          }
        }
      }
    }
  }
}
